      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "A browser older than the pool's session timeout is usually leaked.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (chrome_browser_oldest_age_seconds{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
