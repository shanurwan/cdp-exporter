      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (chrome_browsers{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "browsers {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (chrome_browser_contexts{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "contexts {{instance}}",
          "refId": "B"
