      "type": "timeseries",
      "title": "Zombies by parent",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Zombies exist only until something reaps them; a bar that persists is a parent that never does.",
